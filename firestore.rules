rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/user_profiles/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function currentProfile() {
      return hasProfile() ? get(profilePath()).data : null;
    }

    function currentRole() {
      return hasProfile() ? currentProfile().role : null;
    }

    // Profiles written before schools shared one project carry no schoolId: they are the
    // founding school's, whose data has always lived at artifacts/great-class-quest.
    // Kept to a single lookup: rules allow 1000 evaluated expressions per request and these
    // helpers run inside many others. Without a profile the get() fails, which denies.
    function profileSchoolId() {
      return get(profilePath()).data.get('schoolId', 'great-class-quest');
    }

    function inSchool(schoolId) {
      return profileSchoolId() == schoolId;
    }

    function isFoundingSchool() {
      return profileSchoolId() == 'great-class-quest';
    }

    function schoolDocPath() {
      return /databases/$(database)/documents/schools/$(profileSchoolId());
    }

    // The founding school keeps its plan at appConfig/subscription; every other school's plan
    // is the subscription map on its own schools/{schoolId} doc.
    function schoolPlan() {
      let schoolPath = schoolDocPath();
      return isFoundingSchool()
        ? (exists(subscriptionPath()) ? get(subscriptionPath()).data : {})
        : (exists(schoolPath) && get(schoolPath).data.get('status', 'active') == 'active'
            ? get(schoolPath).data.get('subscription', {})
            : {});
    }

    function secretaryRolePath() {
      return /databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/school_roles/secretary;
    }

    function subscriptionPath() {
      return /databases/$(database)/documents/appConfig/subscription;
    }

    function hasActiveProfile() {
      return hasProfile() &&
        currentProfile().status == 'active' &&
        currentRole() in ['teacher', 'secretary', 'parent'];
    }

    function isTeacher() {
      return hasActiveProfile() && currentRole() == 'teacher';
    }

    function isParent() {
      return hasActiveProfile() && currentRole() == 'parent';
    }

    function isSecretary() {
      let rolePath = secretaryRolePath();
      return hasActiveProfile() &&
        currentRole() == 'secretary' &&
        exists(rolePath) &&
        get(rolePath).data.uid == request.auth.uid &&
        get(rolePath).data.status == 'active';
    }

    function hasActiveSecretaryIn(schoolId) {
      let rolePath = /databases/$(database)/documents/artifacts/$(schoolId)/public/data/school_roles/secretary;
      return exists(rolePath) &&
        get(rolePath).data.status == 'active' &&
        get(rolePath).data.uid is string &&
        exists(/databases/$(database)/documents/user_profiles/$(get(rolePath).data.uid)) &&
        get(/databases/$(database)/documents/user_profiles/$(get(rolePath).data.uid)).data.role == 'secretary' &&
        get(/databases/$(database)/documents/user_profiles/$(get(rolePath).data.uid)).data.status == 'active';
    }

    function hasActiveSecretary() {
      return exists(secretaryRolePath()) &&
        get(secretaryRolePath()).data.status == 'active' &&
        get(secretaryRolePath()).data.uid is string &&
        exists(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)) &&
        get(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)).data.role == 'secretary' &&
        get(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)).data.status == 'active';
    }

    function hasFullSecretaryConsole() {
      return isSecretary() && hasFullSecretaryPlan(schoolPlan());
    }

    function hasFullSecretaryPlan(plan) {
      return plan.get('secretaryAccess', false) == true || plan.get('tier', '') == 'elite';
    }

    function isStaff() {
      return isTeacher() || isSecretary();
    }

    function isYearOperator() {
      return isSecretary();
    }

    function currentYearStatePath() {
      return /databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/school_year_state/current;
    }

    function activeYearKey() {
      let yearPath = currentYearStatePath();
      return exists(yearPath) ? get(yearPath).data.activeYearKey : null;
    }

    function isCoreSchoolSettingsCreate(collection) {
      return collection == 'school_settings' &&
        request.resource.data.keys().hasOnly([
          'schoolName', 'weatherLocation', 'ranges', 'createdAt', 'updatedAt'
        ]);
    }

    function isCoreSchoolSettingsUpdate(collection) {
      return collection == 'school_settings' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolName', 'weatherLocation', 'ranges', 'updatedAt'
        ]);
    }

    function isActiveSchoolYearCreate() {
      let year = activeYearKey();
      return year != null && request.resource.data.schoolYearKey == year;
    }

    function isActiveStudentYearCreate() {
      let year = activeYearKey();
      return year != null && request.resource.data.activeSchoolYearKey == year;
    }

    function isActiveMutableData(data) {
      let year = activeYearKey();
      return year != null &&
        (!('schoolYearKey' in data) || data.schoolYearKey == year) &&
        (!('activeSchoolYearKey' in data) || data.activeSchoolYearKey == year) &&
        (!('status' in data) || !(data.status in ['archived', 'closed']));
    }

    function keepsOwnershipAndYearFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'createdBy',
        'teacherId',
        'markedBy',
        'spunBy',
        'schoolYearKey',
        'activeSchoolYearKey'
      ]);
    }

    function isParentLinkedTo(studentId) {
      return isParent() && hasProfile() && currentProfile().linkedStudentId == studentId;
    }

    function studentPath(studentId) {
      return /databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/students/$(studentId);
    }

    function studentExists(studentId) {
      return exists(studentPath(studentId));
    }

    function studentDoc(studentId) {
      return get(studentPath(studentId)).data;
    }

    function ownsStudent(studentId) {
      return signedIn() && studentExists(studentId) && studentDoc(studentId).createdBy.uid == request.auth.uid;
    }

    function canManageStudent(studentId) {
      return isSecretary() || ownsStudent(studentId);
    }

    function canReadParentStudent(studentId) {
      return signedIn() && (
        isSecretary() ||
        ownsStudent(studentId) ||
        isParentLinkedTo(studentId)
      );
    }

    function threadPath(threadId) {
      return /databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/communication_threads/$(threadId);
    }

    function threadExists(threadId) {
      return exists(threadPath(threadId));
    }

    function threadDoc(threadId) {
      return get(threadPath(threadId)).data;
    }

    function isThreadParticipant(threadId) {
      return signedIn() && threadExists(threadId) && threadDoc(threadId).participantUids.hasAny([request.auth.uid]);
    }

    match /appConfig/subscription {
      allow read: if hasActiveProfile() && isFoundingSchool();
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if hasActiveProfile() && inSchool(schoolId);
      allow write: if false;
    }

    // Root per-user docs carry no school; a user belongs to the school on their profile.
    function sameSchoolUser(userId) {
      return exists(/databases/$(database)/documents/user_profiles/$(userId)) &&
        get(/databases/$(database)/documents/user_profiles/$(userId)).data.get('schoolId', 'great-class-quest') == profileSchoolId();
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isSecretary() && resource.data.get('schoolId', 'great-class-quest') == profileSchoolId())
      );
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('schoolId', 'great-class-quest') == 'great-class-quest' &&
        hasActiveSecretaryIn('great-class-quest') &&
        request.resource.data.keys().hasOnly([
          'role', 'displayName', 'loginMode', 'status', 'schoolId',
          'linkedStudentId', 'createdBy', 'createdAt', 'lastSeenAt'
        ]) &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.loginMode == 'email' &&
        request.resource.data.status == 'active' &&
        request.resource.data.linkedStudentId == null &&
        request.resource.data.createdBy == null;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSeenAt']);
      allow delete: if false;
    }

    match /teacher_metadata/{userId} {
      allow read: if hasActiveProfile() && (request.auth.uid == userId || (isSecretary() && sameSchoolUser(userId)));
      allow write: if hasActiveProfile() && request.auth.uid == userId;
    }

    match /teachers/{userId} {
      allow read: if hasActiveProfile() && (request.auth.uid == userId || (isSecretary() && sameSchoolUser(userId)));
      allow create: if hasActiveProfile() && request.auth.uid == userId;
      allow update: if hasActiveProfile() && (
        request.auth.uid == userId ||
        (hasFullSecretaryConsole() && sameSchoolUser(userId))
      );
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/school_roles/{docId} {
      allow read: if inSchool(schoolId) && (signedIn() && isStaff());
      allow write: if false;
    }

    function ownsClass(classId) {
      return signedIn() && exists(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/classes/$(classId)) &&
        get(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/classes/$(classId)).data.createdBy.uid == request.auth.uid;
    }

    function canScheduleClass(classId) {
      return isSecretary() || (isTeacher() && ownsClass(classId));
    }

    function canRunClass(classId) {
      return isTeacher() && ownsClass(classId);
    }

    match /artifacts/{schoolId}/public/data/admin_bootstrap/{docId} {
      allow read, write: if false;
    }

    match /artifacts/{schoolId}/public/data/school_years/{yearKey} {
      allow read: if inSchool(schoolId) && (hasActiveProfile());
      allow create, update: if inSchool(schoolId) && (isYearOperator());
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/school_year_state/{docId} {
      allow read: if inSchool(schoolId) && (hasActiveProfile());
      allow create, update: if inSchool(schoolId) && (isYearOperator());
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/rollover_jobs/{jobId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create, update: if inSchool(schoolId) && (isYearOperator());
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/student_year_snapshots/{snapshotId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/class_year_snapshots/{snapshotId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/guild_year_snapshots/{snapshotId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/student_year_enrollments/{enrollmentId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/parent_snapshots/{studentId} {
      allow read: if inSchool(schoolId) && (canReadParentStudent(studentId));
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/parent_links/{studentId} {
      allow read: if inSchool(schoolId) && (canManageStudent(studentId));
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/parent_homework/{docId} {
      allow read: if inSchool(schoolId) && (hasActiveProfile() && (
        isSecretary() ||
        isParentLinkedTo(resource.data.studentId) ||
        ownsStudent(resource.data.studentId)
      ));
      allow create, update, delete: if false;
    }

    match /artifacts/{schoolId}/public/data/quest_events/{eventId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create: if inSchool(schoolId) && (canScheduleClass(request.resource.data.classId) && isActiveSchoolYearCreate() && request.resource.data.schemaVersion == 2);
      allow update: if inSchool(schoolId) && (canScheduleClass(resource.data.classId) && isActiveMutableData(resource.data) && isActiveMutableData(request.resource.data) && keepsOwnershipAndYearFields() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateKey', 'date', 'goalSpec', 'rewardSpec', 'presentation', 'updatedAt']));
      allow delete: if inSchool(schoolId) && (canScheduleClass(resource.data.classId) && isActiveMutableData(resource.data));
    }

    match /artifacts/{schoolId}/public/data/quest_event_runs/{runId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create: if inSchool(schoolId) && (canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate());
      allow update: if inSchool(schoolId) && (canRunClass(resource.data.classId) && resource.data.eventId == request.resource.data.eventId && resource.data.classId == request.resource.data.classId && resource.data.runVersion == request.resource.data.runVersion && resource.data.schoolYearKey == request.resource.data.schoolYearKey && isActiveMutableData(resource.data) && isActiveMutableData(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'finalRecipientIds', 'completedBy', 'completedAt', 'completionActionId', 'rewardSummary', 'updatedAt']));
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/quest_event_actions/{actionId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create: if inSchool(schoolId) && (canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate() && request.resource.data.coreStatus == 'applied');
      // Only the retryable effect status may change; core reward fields stay immutable.
      allow update: if inSchool(schoolId) && (canRunClass(resource.data.classId) && isActiveMutableData(resource.data) && isActiveMutableData(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effects', 'updatedAt']));
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/quest_effect_receipts/{receiptId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if false;
    }

    match /artifacts/{schoolId}/public/data/ceremony_snapshots/{snapshotId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create: if inSchool(schoolId) && (canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate());
      allow update: if inSchool(schoolId) && (canRunClass(resource.data.classId) && resource.data.snapshotVersion == request.resource.data.snapshotVersion && ((resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'schoolYearKey', 'classId', 'className', 'classLogo', 'questLeague', 'monthKey', 'mode', 'status', 'classResults', 'studentResultsPrivate', 'classWinner', 'prodigyWinners', 'publicSequence', 'spotlights', 'sourceFingerprint', 'sourceGeneratedAt', 'snapshotVersion', 'playback', 'createdBy', 'updatedAt', 'createdAt'])) || (resource.data.status in ['locked', 'completed'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'playback', 'completedAt', 'completedBy']))));
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/communication_threads/{threadId} {
      allow read: if inSchool(schoolId) && (hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        isThreadParticipant(threadId) ||
        ownsStudent(resource.data.studentId)
      ));
      allow create, update: if false;
      allow delete: if false;
    }

    match /artifacts/{schoolId}/public/data/communication_messages/{messageId} {
      allow read: if inSchool(schoolId) && (hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        isThreadParticipant(resource.data.threadId) ||
        ownsStudent(resource.data.studentId)
      ));
      allow create: if false;
      allow update, delete: if false;
    }

    function campfirePlan() {
      let plan = schoolPlan();
      return plan.get('tier', '') in ['pro', 'elite'] && plan.get('heroCampfire', true) == true;
    }
    function campfireOwner(data) {
      return isTeacher() && data.teacherId == request.auth.uid &&
        data.createdBy.uid == request.auth.uid && data.schoolYearKey == activeYearKey();
    }
    function ownsCampfireClass(classId) {
      let c = get(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/classes/$(classId)).data;
      return classId is string && c.createdBy.uid == request.auth.uid && c.schoolYearKey == activeYearKey();
    }
    function shortText(value, max) { return value is string && value.size() <= max; }
    function oathCheck(list, i) {
      return list.size() <= i || (list[i] is map && list[i].keys().hasOnly(['date', 'mood']) &&
        list[i].date is string && list[i].date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        list[i].mood in ['flame', 'candle', 'moon']);
    }
    function oathEvidence(list, i) {
      let e = list.size() > i ? list[i] : null;
      return list.size() <= i || (e is map && e.keys().hasOnly(['kind', 'label', 'date', 'refId']) &&
        e.kind in ['manual', 'virtue', 'practice', 'quiz'] && shortText(e.label, 160) &&
        shortText(e.refId, 300) && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validOath(data) {
      let student = get(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/students/$(data.studentId)).data;
      let checks = data.checkIns;
      let evidence = data.evidence;
      return data.keys().hasOnly(['studentId','classId','teacherId','createdBy','schoolYearKey','templateId','text','projectorText','category','band','target','evidenceRule','startDate','dueDate','status','private','checkIns','evidence','reflection','legendLine','keptAt','createdAt','updatedAt']) &&
        data.studentId is string && student.createdBy.uid == request.auth.uid && student.classId == data.classId &&
        student.activeSchoolYearKey == data.schoolYearKey && ownsCampfireClass(data.classId) &&
        shortText(data.text, 240) && data.text.size() > 0 && shortText(data.projectorText, 240) &&
        shortText(data.templateId, 80) && shortText(data.legendLine, 280) && data.private is bool &&
        data.category in ['speak','words','write','read/listen','habit','virtue'] && data.band in ['early','junior','mid','upper','exam'] &&
        data.status in ['active','kept','released'] && data.evidenceRule in ['manual','virtue','practice','quiz'] &&
        data.target is map && data.target.keys().hasOnly(['kind','count','reason']) &&
        data.target.kind in ['manual','virtue','practice','quiz'] && data.target.count is int && data.target.count >= 1 && data.target.count <= 12 &&
        (!('reason' in data.target) || data.target.reason in ['Teamwork','Creativity','Respect','Focus']) &&
        data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate >= data.startDate &&
        data.reflection is map && data.reflection.keys().hasOnly(['helped','next','emoji']) &&
        shortText(data.reflection.helped, 240) && shortText(data.reflection.next, 240) && shortText(data.reflection.emoji, 12) &&
        checks is list && checks.size() == 0 && evidence is list && evidence.size() == 0 &&
        data.keptAt == null;
    }
    function validOathProgress(data) {
      let checks = data.checkIns.removeAll(resource.data.checkIns);
      let evidence = data.evidence.removeAll(resource.data.evidence);
      return data.diff(resource.data).affectedKeys().hasOnly(['status','checkIns','evidence','reflection','legendLine','keptAt','updatedAt']) &&
        data.status in ['active','kept','released'] && data.checkIns is list && data.checkIns.size() <= 12 &&
        data.evidence is list && data.evidence.size() <= 12 && checks.size() <= 1 && oathCheck(checks,0) &&
        data.reflection is map && data.reflection.keys().hasOnly(['helped','next','emoji']) &&
        shortText(data.reflection.helped,240) && shortText(data.reflection.next,240) && shortText(data.reflection.emoji,12) &&
        shortText(data.legendLine,280) && (data.keptAt == null || data.keptAt is timestamp) &&
        (evidence.size() == 0 || (
          oathEvidence(evidence,0) && oathEvidence(evidence,1) && oathEvidence(evidence,2) && oathEvidence(evidence,3) &&
          oathEvidence(evidence,4) && oathEvidence(evidence,5) && oathEvidence(evidence,6) && oathEvidence(evidence,7) &&
          oathEvidence(evidence,8) && oathEvidence(evidence,9) && oathEvidence(evidence,10) && oathEvidence(evidence,11)));
    }
    function validCampfire(data) {
      return data.keys().hasOnly(['classId','date','league','band','teacherId','createdBy','schoolYearKey','status','source','script','selfCheck','checkedInIds','keptOathIds','logId','heroStudentId','updatedAt']) &&
        ownsCampfireClass(data.classId) && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        shortText(data.league,30) && data.band in ['early','junior','mid','upper','exam'] &&
        data.status in ['kindled','lit','completed','skipped'] && data.source in ['bank','ai'] &&
        data.selfCheck in [null,'flame','candle','moon'] && data.checkedInIds is list && data.checkedInIds.size() <= 100 &&
        data.keptOathIds is list && data.keptOathIds.size() <= 100 && data.script is map &&
        data.script.keys().hasOnly(['question','followUp','starters','words','embellishments','pattern','circle','rotation','readyOathIds','lessonTarget','fireTale','closingLine','tomorrowSpark','classPromise']) &&
        shortText(data.script.question,220) && shortText(data.script.followUp,220) &&
        shortText(data.script.fireTale,220) && shortText(data.script.closingLine,220) && shortText(data.script.tomorrowSpark,220) &&
        data.script.starters is list && data.script.starters.size() <= 3 && data.script.words is list && data.script.words.size() <= 8 &&
        data.script.circle is list && data.script.circle.size() <= 4 && data.script.readyOathIds is list && data.script.readyOathIds.size() <= 100 &&
        shortText(data.script.classPromise,240) && data.script.rotation is map &&
        (data.script.lessonTarget == null || data.script.lessonTarget is map) &&
        (!('embellishments' in data.script) || (data.script.embellishments is list && data.script.embellishments.size() <= 8)) &&
        (!('pattern' in data.script) || data.script.pattern == null ||
          (data.script.pattern is map && data.script.pattern.keys().hasOnly(['label','example']) &&
           shortText(data.script.pattern.label, 60) && shortText(data.script.pattern.example, 140)));
    }
    match /artifacts/{schoolId}/public/data/ember_oaths/{id} {
      allow read: if inSchool(schoolId) && (isTeacher() && resource.data.teacherId == request.auth.uid && resource.data.schoolYearKey == activeYearKey());
      allow create: if inSchool(schoolId) && (campfirePlan() && campfireOwner(request.resource.data) && validOath(request.resource.data) && request.resource.data.status == 'active');
      allow update: if inSchool(schoolId) && (campfirePlan() && campfireOwner(resource.data) &&
        validOathProgress(request.resource.data) && resource.data.status == 'active');
      allow delete: if false;
    }
    match /artifacts/{schoolId}/public/data/campfire_sessions/{id} {
      allow get: if inSchool(schoolId) && (isTeacher() && (resource == null ||
        (resource.data.teacherId == request.auth.uid && resource.data.schoolYearKey == activeYearKey())));
      allow list: if inSchool(schoolId) && (isTeacher() && resource.data.teacherId == request.auth.uid && resource.data.schoolYearKey == activeYearKey());
      allow create: if inSchool(schoolId) && (campfirePlan() && campfireOwner(request.resource.data) && validCampfire(request.resource.data) &&
        id == request.resource.data.classId + '_' + request.resource.data.date);
      allow update: if inSchool(schoolId) && (campfirePlan() && campfireOwner(resource.data) &&
        keepsOwnershipAndYearFields() && validCampfire(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId','date']) &&
        (resource.data.status != 'completed' || request.resource.data.status == 'completed'));
      allow delete: if false;
    }
    match /artifacts/{schoolId}/public/data/{collection}/{docId} {
      allow read: if inSchool(schoolId) && (!(collection in ['ember_oaths','campfire_sessions']) && hasActiveProfile() && (
        isStaff() ||
        (collection == 'school_settings') ||
        (collection == 'guild_scores' && isParent()) ||
        (collection == 'guild_glory_events' && isParent()) ||
        (collection == 'guild_champions' && isParent())
      ));

      allow create: if inSchool(schoolId) && (!(collection in ['ember_oaths','campfire_sessions']) && hasActiveProfile() && isActiveMutableData(request.resource.data) && (
        (isSecretary() && (hasFullSecretaryConsole() || isCoreSchoolSettingsCreate(collection))) ||
        (isTeacher() && (
        (collection == 'classes' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'students' && request.resource.data.createdBy.uid == request.auth.uid && isActiveStudentYearCreate()) ||
        (collection == 'student_scores' && request.resource.data.createdBy.uid == request.auth.uid && isActiveStudentYearCreate()) ||
        (collection == 'award_log' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'today_stars' && request.resource.data.teacherId == request.auth.uid) ||
        (collection == 'adventure_logs' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_events' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_assignments' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_bounties' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'shop_items' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'written_scores' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'story_data' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'completed_stories' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'attendance' && request.resource.data.markedBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'schedule_overrides' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'class_shields' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'world_boss') ||
        (collection == 'hero_chronicle_notes' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_history' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'daily_ai_content' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache') ||
        (collection == 'quiz_of_the_week' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'fortune_wheel_log' && request.resource.data.spunBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'guild_scores') ||
        (collection == 'guild_glory_events') ||
        (collection == 'guild_champions') ||
        (collection == 'world_boss')
        ))
      ));

      allow update: if inSchool(schoolId) && (!(collection in ['ember_oaths','campfire_sessions']) && hasActiveProfile() && isActiveMutableData(resource.data) &&
        isActiveMutableData(request.resource.data) && keepsOwnershipAndYearFields() && (
        (isSecretary() && (hasFullSecretaryConsole() || isCoreSchoolSettingsUpdate(collection))) ||
        (isTeacher() && (
        (collection == 'classes' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'student_scores' && studentExists(docId) && studentDoc(docId).createdBy.uid == request.auth.uid) ||
        (collection == 'today_stars' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'award_log' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'adventure_logs' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'story_data' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'quest_bounties' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'shop_items' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'class_shields' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'written_scores' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'students' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'hero_chronicle_notes' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'daily_ai_content' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache') ||
        (collection == 'quiz_of_the_week' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'fortune_wheel_log' && resource.data.spunBy.uid == request.auth.uid) ||
        (collection == 'guild_scores') ||
        (collection == 'guild_glory_events') ||
        (collection == 'guild_champions') ||
        (collection == 'world_boss')
        ))
      ));

      allow delete: if inSchool(schoolId) && (!(collection in ['ember_oaths','campfire_sessions']) && hasActiveProfile() && isActiveMutableData(resource.data) && (
        hasFullSecretaryConsole() ||
        (isTeacher() && (
        resource.data.createdBy.uid == request.auth.uid ||
        (collection == 'attendance' && resource.data.markedBy.uid == request.auth.uid) ||
        (collection == 'written_scores' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'schedule_overrides' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'hero_chronicle_notes' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'daily_ai_content' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'quest_bounties' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'shop_items' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'class_shields' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'class_sanctuaries' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache')
        ))
      ));
    }

    match /artifacts/{schoolId}/public/data/quiz_of_the_week/{quizDocId}/attempts/{attemptId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow create: if inSchool(schoolId) && (hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      ));
      allow update, delete: if false;
    }

    match /artifacts/{schoolId}/public/data/student_scores/{studentId}/monthly_history/{monthId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write: if inSchool(schoolId) && (hasFullSecretaryConsole() || ownsStudent(studentId));
    }

    match /artifacts/{schoolId}/public/data/story_data/{classId}/story_history/{historyId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write, delete: if inSchool(schoolId) && (hasFullSecretaryConsole() || (
        isTeacher() &&
        exists(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/story_data/$(classId)) &&
        get(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/story_data/$(classId)).data.createdBy.uid == request.auth.uid
      ));
    }

    match /artifacts/{schoolId}/public/data/completed_stories/{storyId}/chapters/{chapterId} {
      allow read: if inSchool(schoolId) && (isStaff());
      allow write, delete: if inSchool(schoolId) && (hasFullSecretaryConsole() || (
        isTeacher() &&
        exists(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/completed_stories/$(storyId)) &&
        get(/databases/$(database)/documents/artifacts/$(profileSchoolId())/public/data/completed_stories/$(storyId)).data.createdBy.uid == request.auth.uid
      ));
    }
  }
}
