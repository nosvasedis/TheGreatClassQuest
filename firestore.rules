rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/user_profiles/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function currentProfile() {
      return hasProfile() ? get(profilePath()).data : null;
    }

    function currentRole() {
      return hasProfile() ? currentProfile().role : null;
    }

    function secretaryRolePath() {
      return /databases/$(database)/documents/artifacts/great-class-quest/public/data/school_roles/secretary;
    }

    function subscriptionPath() {
      return /databases/$(database)/documents/appConfig/subscription;
    }

    function hasActiveProfile() {
      return hasProfile() &&
        currentProfile().status == 'active' &&
        currentRole() in ['teacher', 'secretary', 'parent'];
    }

    function isTeacher() {
      return hasActiveProfile() && currentRole() == 'teacher';
    }

    function isParent() {
      return hasActiveProfile() && currentRole() == 'parent';
    }

    function isSecretary() {
      return hasActiveProfile() &&
        currentRole() == 'secretary' &&
        exists(secretaryRolePath()) &&
        get(secretaryRolePath()).data.uid == request.auth.uid &&
        get(secretaryRolePath()).data.status == 'active';
    }

    function hasActiveSecretary() {
      return exists(secretaryRolePath()) &&
        get(secretaryRolePath()).data.status == 'active' &&
        get(secretaryRolePath()).data.uid is string &&
        exists(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)) &&
        get(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)).data.role == 'secretary' &&
        get(/databases/$(database)/documents/user_profiles/$(get(secretaryRolePath()).data.uid)).data.status == 'active';
    }

    function hasFullSecretaryConsole() {
      return isSecretary() && exists(subscriptionPath()) && (
        get(subscriptionPath()).data.secretaryAccess == true ||
        get(subscriptionPath()).data.tier == 'elite'
      );
    }

    function isStaff() {
      return isTeacher() || isSecretary();
    }

    function isYearOperator() {
      return isSecretary();
    }

    function currentYearStatePath() {
      return /databases/$(database)/documents/artifacts/great-class-quest/public/data/school_year_state/current;
    }

    function activeYearKey() {
      return exists(currentYearStatePath())
        ? get(currentYearStatePath()).data.activeYearKey
        : null;
    }

    function isCoreSchoolSettingsCreate(collection) {
      return collection == 'school_settings' &&
        request.resource.data.keys().hasOnly([
          'schoolName', 'weatherLocation', 'ranges', 'createdAt', 'updatedAt'
        ]);
    }

    function isCoreSchoolSettingsUpdate(collection) {
      return collection == 'school_settings' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolName', 'weatherLocation', 'ranges', 'updatedAt'
        ]);
    }

    function isActiveSchoolYearCreate() {
      return activeYearKey() != null &&
        request.resource.data.schoolYearKey == activeYearKey();
    }

    function isActiveStudentYearCreate() {
      return activeYearKey() != null &&
        request.resource.data.activeSchoolYearKey == activeYearKey();
    }

    function isActiveMutableData(data) {
      return activeYearKey() != null &&
        (!('schoolYearKey' in data) || data.schoolYearKey == activeYearKey()) &&
        (!('activeSchoolYearKey' in data) || data.activeSchoolYearKey == activeYearKey()) &&
        (!('status' in data) || !(data.status in ['archived', 'closed']));
    }

    function keepsOwnershipAndYearFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'createdBy',
        'teacherId',
        'markedBy',
        'spunBy',
        'schoolYearKey',
        'activeSchoolYearKey'
      ]);
    }

    function isParentLinkedTo(studentId) {
      return isParent() && hasProfile() && currentProfile().linkedStudentId == studentId;
    }

    function studentPath(studentId) {
      return /databases/$(database)/documents/artifacts/great-class-quest/public/data/students/$(studentId);
    }

    function studentExists(studentId) {
      return exists(studentPath(studentId));
    }

    function studentDoc(studentId) {
      return get(studentPath(studentId)).data;
    }

    function ownsStudent(studentId) {
      return signedIn() && studentExists(studentId) && studentDoc(studentId).createdBy.uid == request.auth.uid;
    }

    function canManageStudent(studentId) {
      return isSecretary() || ownsStudent(studentId);
    }

    function canReadParentStudent(studentId) {
      return signedIn() && (
        isSecretary() ||
        ownsStudent(studentId) ||
        isParentLinkedTo(studentId)
      );
    }

    function threadPath(threadId) {
      return /databases/$(database)/documents/artifacts/great-class-quest/public/data/communication_threads/$(threadId);
    }

    function threadExists(threadId) {
      return exists(threadPath(threadId));
    }

    function threadDoc(threadId) {
      return get(threadPath(threadId)).data;
    }

    function isThreadParticipant(threadId) {
      return signedIn() && threadExists(threadId) && threadDoc(threadId).participantUids.hasAny([request.auth.uid]);
    }

    match /appConfig/subscription {
      allow read: if hasActiveProfile();
      allow write: if false;
    }

    match /user_profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isSecretary()
      );
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        hasActiveSecretary() &&
        request.resource.data.keys().hasOnly([
          'role', 'displayName', 'loginMode', 'status',
          'linkedStudentId', 'createdBy', 'createdAt', 'lastSeenAt'
        ]) &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.loginMode == 'email' &&
        request.resource.data.status == 'active' &&
        request.resource.data.linkedStudentId == null &&
        request.resource.data.createdBy == null;
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSeenAt']);
      allow delete: if false;
    }

    match /teacher_metadata/{userId} {
      allow read: if hasActiveProfile() && (request.auth.uid == userId || isSecretary());
      allow write: if hasActiveProfile() && request.auth.uid == userId;
    }

    match /teachers/{userId} {
      allow read: if hasActiveProfile() && (request.auth.uid == userId || isSecretary());
      allow create: if hasActiveProfile() && request.auth.uid == userId;
      allow update: if hasActiveProfile() && (
        request.auth.uid == userId ||
        hasFullSecretaryConsole()
      );
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/school_roles/{docId} {
      allow read: if signedIn() && isStaff();
      allow write: if false;
    }

    function ownsClass(classId) {
      return signedIn() && exists(/databases/$(database)/documents/artifacts/great-class-quest/public/data/classes/$(classId)) &&
        get(/databases/$(database)/documents/artifacts/great-class-quest/public/data/classes/$(classId)).data.createdBy.uid == request.auth.uid;
    }

    function canScheduleClass(classId) {
      return isSecretary() || (isTeacher() && ownsClass(classId));
    }

    function canRunClass(classId) {
      return isTeacher() && ownsClass(classId);
    }

    match /artifacts/great-class-quest/public/data/admin_bootstrap/{docId} {
      allow read, write: if false;
    }

    match /artifacts/great-class-quest/public/data/school_years/{yearKey} {
      allow read: if hasActiveProfile();
      allow create, update: if isYearOperator();
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/school_year_state/{docId} {
      allow read: if hasActiveProfile();
      allow create, update: if isYearOperator();
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/rollover_jobs/{jobId} {
      allow read: if isStaff();
      allow create, update: if isYearOperator();
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/student_year_snapshots/{snapshotId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/class_year_snapshots/{snapshotId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/guild_year_snapshots/{snapshotId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/student_year_enrollments/{enrollmentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/parent_snapshots/{studentId} {
      allow read: if canReadParentStudent(studentId);
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/parent_links/{studentId} {
      allow read: if canManageStudent(studentId);
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/parent_homework/{docId} {
      allow read: if hasActiveProfile() && (
        isSecretary() ||
        isParentLinkedTo(resource.data.studentId) ||
        ownsStudent(resource.data.studentId)
      );
      allow create, update, delete: if false;
    }

    match /artifacts/great-class-quest/public/data/quest_events/{eventId} {
      allow read: if isStaff();
      allow create: if canScheduleClass(request.resource.data.classId) && isActiveSchoolYearCreate() && request.resource.data.schemaVersion == 2;
      allow update: if canScheduleClass(resource.data.classId) && isActiveMutableData(resource.data) && isActiveMutableData(request.resource.data) && keepsOwnershipAndYearFields() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateKey', 'date', 'goalSpec', 'rewardSpec', 'presentation', 'updatedAt']);
      allow delete: if canScheduleClass(resource.data.classId) && isActiveMutableData(resource.data);
    }

    match /artifacts/great-class-quest/public/data/quest_event_runs/{runId} {
      allow read: if isStaff();
      allow create: if canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate();
      allow update: if canRunClass(resource.data.classId) && resource.data.eventId == request.resource.data.eventId && resource.data.classId == request.resource.data.classId && resource.data.runVersion == request.resource.data.runVersion && resource.data.schoolYearKey == request.resource.data.schoolYearKey && isActiveMutableData(resource.data) && isActiveMutableData(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'finalRecipientIds', 'completedBy', 'completedAt', 'completionActionId', 'rewardSummary', 'updatedAt']);
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/quest_event_actions/{actionId} {
      allow read: if isStaff();
      allow create: if canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate() && request.resource.data.coreStatus == 'applied';
      allow update, delete: if false;
    }

    match /artifacts/great-class-quest/public/data/quest_effect_receipts/{receiptId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /artifacts/great-class-quest/public/data/ceremony_snapshots/{snapshotId} {
      allow read: if isStaff();
      allow create: if canRunClass(request.resource.data.classId) && isActiveSchoolYearCreate();
      allow update: if canRunClass(resource.data.classId) && resource.data.snapshotVersion == request.resource.data.snapshotVersion && ((resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'schoolYearKey', 'classId', 'className', 'classLogo', 'questLeague', 'monthKey', 'mode', 'status', 'classResults', 'studentResultsPrivate', 'classWinner', 'prodigyWinners', 'publicSequence', 'spotlights', 'sourceFingerprint', 'sourceGeneratedAt', 'snapshotVersion', 'playback', 'createdBy', 'updatedAt', 'createdAt'])) || (resource.data.status in ['locked', 'completed'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'playback', 'completedAt', 'completedBy'])));
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/communication_threads/{threadId} {
      allow read: if hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        isThreadParticipant(threadId) ||
        ownsStudent(resource.data.studentId)
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /artifacts/great-class-quest/public/data/communication_messages/{messageId} {
      allow read: if hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        isThreadParticipant(resource.data.threadId) ||
        ownsStudent(resource.data.studentId)
      );
      allow create: if false;
      allow update, delete: if false;
    }

    match /artifacts/great-class-quest/public/data/{collection}/{docId} {
      allow read: if hasActiveProfile() && (
        isStaff() ||
        (collection == 'school_settings') ||
        (collection == 'guild_scores' && isParent()) ||
        (collection == 'guild_glory_events' && isParent()) ||
        (collection == 'guild_champions' && isParent())
      );

      allow create: if hasActiveProfile() && isActiveMutableData(request.resource.data) && (
        (isSecretary() && (hasFullSecretaryConsole() || isCoreSchoolSettingsCreate(collection))) ||
        (isTeacher() && (
        (collection == 'classes' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'students' && request.resource.data.createdBy.uid == request.auth.uid && isActiveStudentYearCreate()) ||
        (collection == 'student_scores' && request.resource.data.createdBy.uid == request.auth.uid && isActiveStudentYearCreate()) ||
        (collection == 'award_log' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'today_stars' && request.resource.data.teacherId == request.auth.uid) ||
        (collection == 'adventure_logs' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_events' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_assignments' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_bounties' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'shop_items' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'written_scores' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'story_data' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'completed_stories' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'attendance' && request.resource.data.markedBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'schedule_overrides' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'class_shields' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'world_boss') ||
        (collection == 'hero_chronicle_notes' && request.resource.data.teacherId == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'quest_history' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'daily_ai_content' && request.resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache') ||
        (collection == 'quiz_of_the_week' && request.resource.data.createdBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'fortune_wheel_log' && request.resource.data.spunBy.uid == request.auth.uid && isActiveSchoolYearCreate()) ||
        (collection == 'guild_scores') ||
        (collection == 'guild_glory_events') ||
        (collection == 'guild_champions') ||
        (collection == 'world_boss')
        ))
      );

      allow update: if hasActiveProfile() && isActiveMutableData(resource.data) &&
        isActiveMutableData(request.resource.data) && keepsOwnershipAndYearFields() && (
        (isSecretary() && (hasFullSecretaryConsole() || isCoreSchoolSettingsUpdate(collection))) ||
        (isTeacher() && (
        (collection == 'classes' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'student_scores' && studentExists(docId) && studentDoc(docId).createdBy.uid == request.auth.uid) ||
        (collection == 'today_stars' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'award_log' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'adventure_logs' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'story_data' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'quest_bounties' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'shop_items' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'class_shields' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'written_scores' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'students' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'hero_chronicle_notes' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'daily_ai_content' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache') ||
        (collection == 'quiz_of_the_week' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'fortune_wheel_log' && resource.data.spunBy.uid == request.auth.uid) ||
        (collection == 'guild_scores') ||
        (collection == 'guild_glory_events') ||
        (collection == 'guild_champions') ||
        (collection == 'world_boss')
        ))
      );

      allow delete: if hasActiveProfile() && isActiveMutableData(resource.data) && (
        hasFullSecretaryConsole() ||
        (isTeacher() && (
        resource.data.createdBy.uid == request.auth.uid ||
        (collection == 'attendance' && resource.data.markedBy.uid == request.auth.uid) ||
        (collection == 'written_scores' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'schedule_overrides' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'hero_chronicle_notes' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'daily_ai_content' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'quest_bounties' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'shop_items' && resource.data.teacherId == request.auth.uid) ||
        (collection == 'class_shields' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'class_sanctuaries' && resource.data.createdBy.uid == request.auth.uid) ||
        (collection == 'daily_cache')
        ))
      );
    }

    match /artifacts/great-class-quest/public/data/quiz_of_the_week/{quizDocId}/attempts/{attemptId} {
      allow read: if isStaff();
      allow create: if hasActiveProfile() && (
        hasFullSecretaryConsole() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /{path=**}/monthly_history/{monthId} {
      allow read: if isStaff();
    }

    match /artifacts/great-class-quest/public/data/student_scores/{studentId}/monthly_history/{monthId} {
      allow write: if hasFullSecretaryConsole() || ownsStudent(studentId);
    }

    match /artifacts/great-class-quest/public/data/story_data/{classId}/story_history/{historyId} {
      allow read: if isStaff();
      allow write, delete: if hasFullSecretaryConsole() || (
        isTeacher() &&
        exists(/databases/$(database)/documents/artifacts/great-class-quest/public/data/story_data/$(classId)) &&
        get(/databases/$(database)/documents/artifacts/great-class-quest/public/data/story_data/$(classId)).data.createdBy.uid == request.auth.uid
      );
    }

    match /artifacts/great-class-quest/public/data/completed_stories/{storyId}/chapters/{chapterId} {
      allow read: if isStaff();
      allow write, delete: if hasFullSecretaryConsole() || (
        isTeacher() &&
        exists(/databases/$(database)/documents/artifacts/great-class-quest/public/data/completed_stories/$(storyId)) &&
        get(/databases/$(database)/documents/artifacts/great-class-quest/public/data/completed_stories/$(storyId)).data.createdBy.uid == request.auth.uid
      );
    }
  }
}
