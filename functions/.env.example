# Copy to functions/.env (git-ignored). Firebase loads it when deploying Cloud Functions.
# Step-by-step Stripe setup: tools/STRIPE_SETUP.md
#
# Online payment (Stripe) stays OFF until this is true. Before turning it on, store the two
# secrets in Secret Manager (they are never written to a file):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
GCQ_ENABLE_STRIPE=false

# Two Stripe prices per plan (keep them equal to config/tiers/pricing.mjs, before VAT):
#   monthly = recurring every month (charged September to June; summer is paused automatically)
#   yearly  = recurring every year (renews 1 September)
GCQ_STRIPE_PRICE_STARTER_MONTHLY=
GCQ_STRIPE_PRICE_STARTER_YEARLY=
GCQ_STRIPE_PRICE_PRO_MONTHLY=
GCQ_STRIPE_PRICE_PRO_YEARLY=
GCQ_STRIPE_PRICE_ELITE_MONTHLY=
GCQ_STRIPE_PRICE_ELITE_YEARLY=

# Greek VAT 24%, added on top: the Stripe tax rate id (txr_...).
GCQ_STRIPE_TAX_RATE=

# Optional: a Customer Portal configuration id (bpc_...). Empty = Stripe's default portal.
GCQ_STRIPE_PORTAL_CONFIGURATION=

# Optional: extra sites Stripe may send people back to (comma separated). The Cloudflare
# site and localhost are always allowed.
GCQ_BILLING_RETURN_ORIGINS=

# Stripe webhook endpoint to register (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted):
#   https://europe-west1-the-great-class-quest.cloudfunctions.net/stripeWebhook
