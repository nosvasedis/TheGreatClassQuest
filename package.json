{
  "name": "the-great-class-quest",
  "version": "0.1.0",
  "description": "The Great Class Quest",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && node scripts/finalize-vite-build.cjs && node scripts/check-bundle-budget.cjs",
    "build:static": "npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "billing": "node billing/server.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "test:e2e": "playwright test",
    "test:rules": "node node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore,storage --project demo-gcq \"node --test tests/rules/firestore.rules.test.cjs\"",
    "audit:prod": "node scripts/audit-production.cjs",
    "set-subscription": "node scripts/set-subscription.js",
    "onboard-school": "node billing/scripts/onboard-new-school.js",
    "setup-school": "node scripts/billing-wizard.js",
    "onboarding-console": "node scripts/onboarding-console.js",
    "ngrok": "ngrok http 3333",
    "sync-version": "node scripts/sync-app-version.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.1",
    "autoprefixer": "^10.5.4",
    "axe-core": "4.13.0",
    "firebase-admin": "14.2.0",
    "firebase-tools": "^15.26.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "vite": "8.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.2",
    "chart.js": "4.5.1",
    "firebase": "12.17.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "tone": "14.8.49"
  }
}
