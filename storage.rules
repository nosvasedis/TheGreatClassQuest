rules_version = '2';

// These rules read Firestore (user_profiles, classes, students). That needs the Storage
// service agent to hold roles/firebaserules.firestoreServiceAgent. The Firebase CLI only
// offers to grant it in an interactive deploy that uploads changed rules; without it every
// firestore.* lookup fails and all uploads get storage/unauthorized.
//
// Storage rules may make at most 2 firestore.exists()/get() calls per request; going over is a
// permission denied. Only repeated identical calls "may" be cached, so an exists() + get() pair
// on the same document can already use both. Every lookup here is therefore one firestore.get()
// per document, never an exists() first: a missing document makes get() fail, which denies,
// exactly where the old exists() check returned false. A teacher's own uploads read only their
// profile (plus the student or class doc for avatars, familiars and story pictures).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/user_profiles/$(request.auth.uid);
    }

    function currentProfile() {
      return firestore.get(profilePath()).data;
    }

    function currentRole() {
      return currentProfile().role;
    }

    function hasActiveProfile() {
      return signedIn() &&
        currentProfile().status == 'active' &&
        currentRole() in ['teacher', 'secretary', 'parent'];
    }

    // Profiles without a schoolId belong to the founding school (artifacts/great-class-quest).
    function profileSchoolId() {
      return currentProfile().get('schoolId', 'great-class-quest');
    }

    function sameSchoolUser(userId) {
      return firestore.get(/databases/(default)/documents/user_profiles/$(userId)).data
        .get('schoolId', 'great-class-quest') == profileSchoolId();
    }

    function isTeacher() {
      return hasActiveProfile() && currentRole() == 'teacher';
    }

    function isSecretary() {
      let rolePath = /databases/(default)/documents/artifacts/$(profileSchoolId())/public/data/school_roles/secretary;
      return hasActiveProfile() &&
        currentRole() == 'secretary' &&
        firestore.get(rolePath).data.uid == request.auth.uid &&
        firestore.get(rolePath).data.status == 'active';
    }

    // The founding school's plan stays at appConfig/subscription; other schools keep theirs on
    // schools/{schoolId}.subscription.
    function schoolPlan() {
      let legacyPath = /databases/(default)/documents/appConfig/subscription;
      let schoolPath = /databases/(default)/documents/schools/$(profileSchoolId());
      return profileSchoolId() == 'great-class-quest'
        ? firestore.get(legacyPath).data
        : firestore.get(schoolPath).data.get('subscription', {});
    }

    function hasFullSecretaryConsole() {
      return isSecretary() && (
        schoolPlan().get('secretaryAccess', false) == true ||
        schoolPlan().get('tier', '') == 'elite'
      );
    }

    // The student / class must exist (a missing doc makes get() fail, which denies). The teacher
    // branch comes first so a teacher never reaches the Secretary lookups.
    function canManageStudent(studentId) {
      let studentPath = /databases/(default)/documents/artifacts/$(profileSchoolId())/public/data/students/$(studentId);
      return hasActiveProfile() && firestore.get(studentPath) != null && (
        (isTeacher() && firestore.get(studentPath).data.createdBy.uid == request.auth.uid) ||
        hasFullSecretaryConsole()
      );
    }

    function canManageClass(classId) {
      let classPath = /databases/(default)/documents/artifacts/$(profileSchoolId())/public/data/classes/$(classId);
      return hasActiveProfile() && firestore.get(classPath) != null && (
        (isTeacher() && firestore.get(classPath).data.createdBy.uid == request.auth.uid) ||
        hasFullSecretaryConsole()
      );
    }

    function isValidImageWrite() {
      return request.resource == null || (
        request.resource.size <= 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    match /adventure_logs/{userId}/{allPaths=**} {
      allow read: if hasActiveProfile();
      allow write: if hasActiveProfile() && isValidImageWrite() && (request.auth.uid == userId || (hasFullSecretaryConsole() && sameSchoolUser(userId)));
    }

    match /avatars/{studentId}/{fileName} {
      allow read: if hasActiveProfile();
      allow write: if canManageStudent(studentId) && isValidImageWrite();
    }

    match /avatars/{legacyFileName} {
      allow read: if hasActiveProfile();
      allow write: if false;
    }

    match /story_images/{classId}/{fileName} {
      allow read: if hasActiveProfile();
      allow write: if canManageClass(classId) && isValidImageWrite();
    }

    match /pet_images/{allPaths=**} {
      allow read: if hasActiveProfile();
      allow write: if (isTeacher() || hasFullSecretaryConsole()) && isValidImageWrite();
    }

    match /shop_items/{userId}/{allPaths=**} {
      allow read: if hasActiveProfile();
      allow write: if isValidImageWrite() && (isTeacher() || hasFullSecretaryConsole()) && (request.auth.uid == userId || (hasFullSecretaryConsole() && sameSchoolUser(userId)));
    }

    match /familiars/{studentId}/{fileName} {
      allow read: if hasActiveProfile();
      allow write: if canManageStudent(studentId) && isValidImageWrite();
    }

    match /familiars/{legacyFileName} {
      allow read: if hasActiveProfile();
      allow write: if false;
    }

    match /quiz_images/{userId}/{fileName} {
      allow read: if hasActiveProfile();
      allow write: if isValidImageWrite() && (isTeacher() || hasFullSecretaryConsole()) && (request.auth.uid == userId || (hasFullSecretaryConsole() && sameSchoolUser(userId)));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
